C3_BASE_URL=https://your-domain.c3.pe
C3_USERNAME=
C3_PASSWORD=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto para firmar los JWT de sesion -- generalo con `openssl rand -hex 32`.
AUTH_JWT_SECRET=
# Opcionales -- si estan seteadas Y la tabla users esta vacia, el server crea esta cuenta
# (admin) al arrancar. No hacen nada si la tabla ya tiene al menos un usuario.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
