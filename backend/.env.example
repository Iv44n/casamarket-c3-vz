C3_BASE_URL=https://your-domain.c3.pe
C3_USERNAME=
C3_PASSWORD=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# La config del proveedor LLM (para el analisis de calidad de benchmarks) ya NO se lee de
# variables de entorno -- la configuran los admins desde el panel (PUT /benchmarks/settings),
# guardada en Turso (app/benchmarks/settings.py). No hace falta redeployar para cambiar de
# modelo o rotar la api key.

# Secreto para firmar los JWT de sesion -- generalo con `openssl rand -hex 32`.
AUTH_JWT_SECRET=
# Opcionales -- si estan seteadas Y la tabla users esta vacia, el server crea esta cuenta
# (admin) al arrancar. No hacen nada si la tabla ya tiene al menos un usuario.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=

# Lista de origenes separados por coma que puede llamar a esta API desde un browser (CORS).
# Default sin esta variable: http://localhost:3000 (el puerto de `bun run dev` del frontend).
# En Render/Vercel, poner el/los dominio(s) reales del frontend, p.ej.:
# CORS_ALLOWED_ORIGINS=https://c3-panel.vercel.app,https://c3-panel-staging.vercel.app
CORS_ALLOWED_ORIGINS=
